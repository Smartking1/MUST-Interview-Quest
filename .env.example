# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=openai
LLM_MODEL=            # exact OpenAI model ID for the agent (Trusted and baseline use the same one)
OPENAI_API_KEY=
# LLM_TEMPERATURE=0   # optional; some models reject temperature
JUDGE_MODEL=          # Inspect model string for the invented_policy judge, e.g. openai/<model id>
ATTACKER_MODEL=       # Inspect model string for the Day 4 adaptive attacker
DECISION_SECRET=      # HMAC secret for signed decisions; random per process if unset
PAYMENT_GATEWAY=fake  # fake (default) or stripe
STRIPE_SECRET_KEY=    # sk_test_... only. The app refuses to start on a live key
# STRIPE_API_BASE=http://localhost:12111   # optional: point at a local stripe-mock
VISION_MODEL=         # optional: model that describes customer photos for staff; defaults to LLM_MODEL
DATABASE_URL=sqlite:///harbor.db
